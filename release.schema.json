{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ArkUI release metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format", "schema_version", "release_id", "created_at", "target",
    "release_type", "build_variant", "versions", "build_timestamp", "fingerprint",
    "build_tags", "source_state", "validation", "artifacts"
  ],
  "properties": {
    "format": { "const": "arkui.release" },
    "schema_version": { "const": 1 },
    "release_id": { "type": "string", "format": "uuid" },
    "created_at": { "type": "string", "format": "date-time" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "product", "kind", "device", "board", "architecture", "flavor"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
        "product": { "type": "string", "pattern": "^lineage_[A-Za-z0-9_]+$" },
        "kind": { "enum": ["gsi", "device"] },
        "device": { "type": "string", "minLength": 1 },
        "board": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "pattern": "^[A-Za-z0-9_+-]+$" },
        "flavor": { "type": "string", "pattern": "^[A-Za-z0-9_+-]+$" }
      }
    },
    "release_type": {
      "enum": ["EXPERIMENTAL", "OFFICIAL", "RELEASE", "NIGHTLY", "SNAPSHOT", "UNOFFICIAL"]
    },
    "build_variant": { "enum": ["user", "userdebug", "eng"] },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rom", "base", "build_number", "display", "android", "sdk", "security_patch"],
      "properties": {
        "rom": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}(?:[-+][A-Za-z0-9.-]+)?$" },
        "base": { "type": "string", "minLength": 1 },
        "build_number": { "type": "string", "pattern": "^(?!eng\\.)[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
        "display": { "type": "string", "minLength": 1 },
        "android": { "type": "string", "minLength": 1 },
        "sdk": { "type": "integer", "minimum": 1 },
        "security_patch": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      }
    },
    "build_timestamp": { "type": "integer", "minimum": 1 },
    "fingerprint": { "type": "string", "minLength": 1 },
    "build_tags": { "type": "string", "minLength": 1 },
    "source_state": { "enum": ["clean", "dirty"] },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["build_success", "boot_verified"],
      "properties": {
        "build_success": { "const": true },
        "boot_verified": { "const": false }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "bytes", "sha256", "role", "format"],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9_-][A-Za-z0-9._+ -]*/)*[A-Za-z0-9_-][A-Za-z0-9._+ -]*$"
        },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "role": { "enum": ["system", "rom"] },
        "format": { "type": "string", "pattern": "^[a-z0-9]+$" },
        "raw_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "raw_bytes": { "type": "integer", "minimum": 1 }
      },
      "dependentRequired": {
        "raw_sha256": ["raw_bytes"],
        "raw_bytes": ["raw_sha256"]
      }
    }
  }
}
